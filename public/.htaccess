# Evita que el navegador guarde en caché el index.html.
# Como cada despliegue genera archivos JS/CSS con nombres nuevos (hash),
# si el index.html queda cacheado en el navegador puede apuntar a archivos
# que ya no existen y la página se queda en blanco.
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Los archivos dentro de /assets/ sí llevan hash en el nombre,
  # así que es seguro cachearlos por mucho tiempo.
  <FilesMatch "\.(js|css|png|jpg|jpeg|svg|webp|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
